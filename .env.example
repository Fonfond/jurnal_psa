NODE_ENV=development
PORT=3001

# Production PostgreSQL (если задан — используется pg, иначе PGlite).
# ВАЖНО: NODE_ENV=production требует DATABASE_URL — без него API не стартует
# (fail-closed, чтобы не уйти в PGlite/память); PGlite допустим только локально.
# DATABASE_URL=postgres://logbook:logbook@localhost:5432/logbook
# TLS к БД: disable для localhost, require/verify-full для внешней БД
DATABASE_SSL_MODE=disable
# DATABASE_SSL_CA_PATH=db/postgres/certs/server.crt
# Размер пула соединений на один инстанс API
# For load/QA: keep >= concurrent VUs + 8 (e.g. 28 for 20 VU); async audit writer uses a connection too.
DATABASE_POOL_MAX=10

# Локальная PGlite: путь к каталогу данных. Пусто — in-memory.
PGLITE_DIR=.data/pglite

RUN_MIGRATIONS_ON_START=true
DEV_SEED_PASSWORD=Logbook!2026
# Demo fixtures (6 domain permits/orders + 9 records) are ON for the demo
# stack. Set false for an empty journal; tests use deterministic fixtures.
SEED_DEMO_DATA=true
SEED_DEMO_PROFILE=electrical
COOKIE_SECRET=dev-only-change-me
SESSION_TTL_DAYS=30
# AUTH-04: idle timeout (production <= 120 min) and API/edge rate limiting
SESSION_IDLE_MINUTES=30
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_MAX=20
# LOADTEST ONLY: bypass the per-IP limiter to measure latency; env.ts rejects it
# in production. Never enable on a production/pilot stand.
# LOADTEST_RATE_LIMIT_DISABLED=true
# Cold loadtest: warm-up is not measured; loadtest re-runs ANALYZE afterwards.
# WARMUP_MS=60000
# LOADTEST_ANALYZE=0 disables the mandatory pre-load/after-warm-up ANALYZE (finding only).
# HSTS on HTTPS responses in production (0 disables); 31536000 = 1 year
HSTS_MAX_AGE_SECONDS=31536000
# Behind nginx/reverse proxy: trust X-Forwarded-For/Proto
TRUST_PROXY=false
CORS_ORIGIN=http://localhost:5173
# ADR-14: отдельный origin админки (production: https, не равен CORS_ORIGIN)
# ADMIN_ORIGIN=https://admin.logbook.example.com
# Полный production-профиль и гейты — 35_Руководство_по_установке.md §5
# FR-PRM-11: all = текущее демо-поведение, participant = только наряды с участием
PERMIT_VISIBILITY_MODE=all
# OQ-03: signed permit PDF links (TTL ≤ 900 seconds, secret falls back to COOKIE_SECRET)
PERMIT_PDF_SECRET=dev-only-permit-pdf-secret-change-me-32+
PERMIT_PDF_TTL_SECONDS=900
# PERMIT_PDF_PUBLIC_BASE_URL=https://logbook.example.com
# WORM journal export / retention (JRN-04/JRN-07)
EXPORT_SIGNING_SECRET=dev-only-export-secret-change-me-32+
EXPORT_URL_TTL_SECONDS=900
# EXPORT_PUBLIC_BASE_URL=https://logbook.example.com
RETENTION_YEARS=3
# REP-05: daily retention scheduler (in-process; disable when external timer is used)
RETENTION_SCHEDULER_ENABLED=true
RETENTION_SCHEDULE_UTC=02:00
RETENTION_OVERDUE_HOURS=26
# TTL: change_log (ADR-07) and expired non-WORM export_jobs
CHANGE_LOG_RETENTION_DAYS=90
EXPORT_JOB_RETENTION_DAYS=7
# Optional ops webhook for retention alerts (JSON POST)
# RETENTION_ALERT_WEBHOOK_URL=https://alerts.example.com/logbook
RETENTION_ALERT_TIMEOUT_MS=5000

# --- Аутентификация (ADR-22 dev / ADR-23 OIDC) ---
# dev = email + пароль из seed (только локально); oidc = Authorization Code + PKCE.
AUTH_PROVIDER=dev
DEV_LOGIN_ENABLED=true
# OIDC-профиль production (раскомментировать и заполнить):
# OIDC_ISSUER=https://idp.example.com/realms/logbook
# OIDC_CLIENT_ID=logbook
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://logbook.example.com/v1/auth/callback
# OIDC_POST_LOGIN_REDIRECT=/
# OIDC_DISPLAY_NAME=Корпоративный IdP
# OIDC_SCOPES=openid profile email
# OIDC_ALLOWED_ALGORITHMS=RS256
# OIDC_JIT_PROVISION=false
# OIDC_JIT_DEPARTMENT_ID=
# NFR-SEC-02: MFA required for admins (acr/amr from IdP; production must be true)
OIDC_REQUIRE_MFA_FOR_ADMIN=true
# Accepted acr values (comma-separated), sent as acr_values on authorize
OIDC_MFA_ACR_VALUES=mfa

# --- Электронная подпись (OQ-04) ---
# none = без ЭП; simple = HMAC сервера (не КЭП); qualified = внешний сервис КЭП.
SIGNATURE_PROVIDER=simple
SIGNATURE_SECRET=dev-only-signature-secret-change-me-32+
SIGNATURE_KEY_ID=logbook-dev-v1
SIGNATURE_AUTO_SIGN=true
# SIGNATURE_QUALIFIED_ENDPOINT=https://cryptopro.example.com/api/sign
# SIGNATURE_QUALIFIED_TOKEN=

VITE_API_URL=/v1
VITE_APP_VERSION=0.2.0
# Отдельная admin-сборка (ADR-14): npm run build:web с этим значением
# VITE_ADMIN_ORIGIN=https://admin.logbook.example.com
VITE_ENABLE_DEV_LOGIN=true
VITE_DEV_PASSWORD=Logbook!2026
VITE_ENABLE_ON_DEVICE_ASR=false
VITE_ENABLE_WEB_SPEECH=false
